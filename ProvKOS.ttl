@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:creator a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

skos:ConceptScheme a owl:Class ;
    skos:definition "Within the scope of this application profile, any SKOS concept scheme can serve as a warrant for editorial decision making (e.g., ICD-11 or a national authority file supporting a change). Warrant-hood is acquired by role: a concept scheme used as the object of ProvKOS:wasWarrantedBy or ProvKOS:cite is inferred to be a ProvKOS:Warrant via those properties' ranges; other concept schemes are unaffected."@en .

skos:altLabel a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:inScheme a owl:ObjectProperty ;
    rdfs:domain skos:Concept .

<http://www.w3.org/2008/05/skos-xl#literalForm> a owl:DatatypeProperty ;
    rdfs:label "literalForm"@en ;
    rdfs:domain <http://www.w3.org/2008/05/skos-xl#Label> ;
    rdfs:range xsd:string .

prov:Organization a owl:Class ;
    rdfs:subClassOf prov:Agent .

prov:Person a owl:Class ;
    rdfs:subClassOf prov:Agent .

prov:SoftwareAgent a owl:Class ;
    rdfs:subClassOf prov:Agent .

prov:endedAtTime a owl:DatatypeProperty .

prov:generated a owl:ObjectProperty .

prov:invalidated a owl:ObjectProperty .

prov:startedAtTime a owl:DatatypeProperty .

prov:wasAssociatedWith a owl:ObjectProperty .

prov:wasAttributedTo a owl:ObjectProperty ;
    rdfs:domain prov:Entity .

prov:wasRevisionOf a owl:ObjectProperty .

<https://w3id.org/def/ProvKOS> a owl:Ontology ;
    dcterms:creator "Inkyung Choi",
        "Jessica Yi-Yun Cheng" ;
    dcterms:title "ProvKOS: An Application Profile for Documenting Provenance in Knowledge Organization Systems"@en ;
    rdfs:comment "ProvKOS extends SKOS and PROV-O to represent the provenance of editorial activities in Knowledge Organization Systems (KOS): typed change activities, warrant structures, and the relationships among entities, activities, agents, and warrants. Revised in response to peer review (2026): class renamed to ProvKOS:ClassNumber; domain of ProvKOS:hasLabel broadened to prov:Entity; explicit PROV-O sub-property alignments; example individuals moved to separate data files. Version 1.2: the global axioms declaring skos:Concept and skos:ConceptScheme as subclasses of ProvKOS:Warrant were removed; warrant-hood is now typed by role through the ranges of ProvKOS:wasWarrantedBy and ProvKOS:cite, so that only resources actually participating as warrants are inferred to be ProvKOS:Warrant instances."@en ;
    owl:imports <http://www.w3.org/2004/02/skos/core>,
        <http://www.w3.org/ns/prov-o-20130430> ;
    owl:versionInfo "1.2" .

<https://w3id.org/def/ProvKOS#Expansion> a owl:Class ;
    rdfs:label "Expansion"@en ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "An expansion is when a concept is extended and the class number moves down to the narrower hierarchy."@en .

<https://w3id.org/def/ProvKOS#Literature> a owl:Class ;
    rdfs:label "Literature"@en ;
    rdfs:subClassOf <https://w3id.org/def/ProvKOS#Warrant> ;
    skos:definition "Citable literature providing evidence warranted for editorial decision making."@en .

<https://w3id.org/def/ProvKOS#Relocation> a owl:Class ;
    rdfs:label "Relocation"@en ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "A relocation is moving a concept from a class number to another class number; this movement is outside of the hierarchical tree."@en .

<https://w3id.org/def/ProvKOS#Replacement> a owl:Class ;
    rdfs:label "Replacement"@en ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "A replacement is having a label replaced with another label."@en .

<https://w3id.org/def/ProvKOS#Truncation> a owl:Class ;
    rdfs:label "Truncation"@en ;
    rdfs:subClassOf prov:Activity ;
    skos:altLabel "Discontinuation"@en ;
    skos:definition "A truncation is having a concept generalized, thus the class number moves up to the broader hierarchy."@en .

<https://w3id.org/def/ProvKOS#cite> a owl:ObjectProperty ;
    rdfs:label "cite"@en ;
    rdfs:domain <https://w3id.org/def/ProvKOS#Warrant> ;
    rdfs:range <https://w3id.org/def/ProvKOS#Warrant> ;
    skos:definition "A Warrant cites another Warrant, enabling the construction of warrant chains across heterogeneous evidence types (e.g., a Document citing a ConceptScheme that cites Literature)."@en .

<https://w3id.org/def/ProvKOS#documentDate> a owl:DatatypeProperty ;
    rdfs:label "documentDate"@en ;
    rdfs:domain <https://w3id.org/def/ProvKOS#Document> ;
    rdfs:range xsd:date ;
    skos:definition "The date of an editorial document serving as a warrant."@en .

<https://w3id.org/def/ProvKOS#documentURI> a owl:AnnotationProperty ;
    rdfs:label "documentURI"@en ;
    skos:definition "A dereferenceable URI at which an editorial document serving as a warrant is available."@en .

<https://w3id.org/def/ProvKOS#hasLabel> a owl:ObjectProperty ;
    rdfs:label "hasLabel"@en ;
    rdfs:domain prov:Entity ;
    rdfs:range <http://www.w3.org/2008/05/skos-xl#Label> ;
    skos:definition "A KOS entity (e.g., a class number in a classification system, or an authority record in a compiled vocabulary) has one or more associated human-readable labels. Preferred and alternative labels can be distinguished using skosxl:prefLabel and skosxl:altLabel for tracking changes to all types of labels."@en .

<https://w3id.org/def/ProvKOS#wasAuthorizedBy> a owl:ObjectProperty ;
    rdfs:label "wasAuthorizedBy"@en ;
    rdfs:domain <https://w3id.org/def/ProvKOS#ClassNumber> ;
    rdfs:range prov:Activity ;
    rdfs:subPropertyOf prov:wasGeneratedBy ;
    skos:definition "An 'unassigned' class number is being used to represent a concept. Specific to classification systems in which class numbers persist as reusable containers."@en .

<https://w3id.org/def/ProvKOS#wasDeprecatedBy> a owl:ObjectProperty ;
    rdfs:label "wasDeprecatedBy"@en ;
    rdfs:domain <https://w3id.org/def/ProvKOS#ClassNumber> ;
    rdfs:range prov:Activity ;
    rdfs:subPropertyOf prov:wasInvalidatedBy ;
    skos:definition "The existing class number is deprecated, becoming 'unassigned'. Specific to classification systems in which class numbers persist as reusable containers."@en .

<https://w3id.org/def/ProvKOS#wasWarrantedBy> a owl:ObjectProperty ;
    rdfs:label "wasWarrantedBy"@en ;
    rdfs:domain prov:Activity ;
    rdfs:range <https://w3id.org/def/ProvKOS#Warrant> ;
    rdfs:subPropertyOf prov:wasInfluencedBy ;
    skos:definition "The Activity was performed based on an editorial Warrant."@en .

skos:Concept a owl:Class ;
    skos:definition "Within the scope of this application profile, any SKOS concept can serve as a warrant for editorial decision making (e.g., a concept in an external vocabulary such as Homosaurus supporting a label change). Warrant-hood is acquired by role: a concept used as the object of ProvKOS:wasWarrantedBy or ProvKOS:cite is inferred to be a ProvKOS:Warrant via those properties' ranges; other concepts are unaffected."@en .

prov:wasGeneratedBy a owl:ObjectProperty .

prov:wasInfluencedBy a owl:ObjectProperty .

prov:wasInvalidatedBy a owl:ObjectProperty .

<https://w3id.org/def/ProvKOS#Document> a owl:Class ;
    rdfs:label "Document"@en ;
    rdfs:subClassOf <https://w3id.org/def/ProvKOS#Warrant> ;
    skos:definition "Documents to record editorial process which include proposals of changes, discussions of proposals, and suggested changes and their impacts."@en .

<http://www.w3.org/2008/05/skos-xl#Label> a owl:Class ;
    rdfs:label "Label"@en ;
    rdfs:subClassOf prov:Entity ;
    owl:disjointWith <https://w3id.org/def/ProvKOS#ClassNumber> ;
    skos:definition "The class skosxl:Label is a special class of lexical entities. An instance of the class skosxl:Label is a resource and may be named with a URI. An instance of the class skosxl:Label has a single literal form. (from SKOS-XL)"@en .

prov:Agent a owl:Class ;
    rdfs:subClassOf owl:Thing .

<https://w3id.org/def/ProvKOS#ClassNumber> a owl:Class ;
    rdfs:label "Class Number"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "ClassNumber is a numeric or alphanumeric notation to represent a concept. A concept is defined as a unit of thought, specific ideas or meanings established within a KOS. ClassNumber is assignable to classify information resources. An instance of ClassNumber may be named with a URI."@en .

prov:Entity a owl:Class ;
    rdfs:subClassOf owl:Thing .

<https://w3id.org/def/ProvKOS#Warrant> a owl:Class ;
    rdfs:label "Warrant"@en ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "Any identifiable sources providing evidence warranted for editorial decision making."@en .

prov:Activity a owl:Class ;
    rdfs:subClassOf owl:Thing .

